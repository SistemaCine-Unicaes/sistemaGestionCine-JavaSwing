<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
    xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ReportePorFuncion"
    pageWidth="595"
    pageHeight="842"
    columnWidth="525"
    leftMargin="35"
    rightMargin="35"
    topMargin="30"
    bottomMargin="30"
    whenNoDataType="NoPages">

    <parameter name="ID_FUNCION" class="java.lang.Integer"/>

    <queryString>
        <![CDATA[
            SELECT
                f.id_funcion,
                p.nombre AS pelicula,
                f.fecha_proyeccion,
                f.hora_inicio,
                f.id_sala,
                f.estado::text AS estado,
                s.capacidad_total,
                t.id_ticket,
                a.fila AS fila_asiento,
                a.numero AS numero_asiento,
                u.nombre AS cajero,
                t.monto,
                t.fecha_hora_compra,
                COUNT(t.id_ticket) OVER (
                    PARTITION BY f.id_funcion
                ) AS total_boletos,
                COALESCE(
                    SUM(t.monto) OVER (
                        PARTITION BY f.id_funcion
                    ), 0
                ) AS total_ingresos
            FROM Funcion f
            JOIN Pelicula p
                ON p.id_pelicula = f.id_pelicula
            JOIN Sala s
                ON s.id_sala = f.id_sala
            LEFT JOIN Ticket t
                ON t.id_funcion = f.id_funcion
            LEFT JOIN Asiento a
                ON a.id_asiento = t.id_asiento
            LEFT JOIN Usuario u
                ON u.id_usuario = t.id_usuario
            WHERE f.id_funcion = $P{ID_FUNCION}
            ORDER BY t.id_ticket
        ]]>
    </queryString>

    <field name="id_funcion" class="java.lang.Integer"/>
    <field name="pelicula" class="java.lang.String"/>
    <field name="fecha_proyeccion" class="java.sql.Date"/>
    <field name="hora_inicio" class="java.sql.Time"/>
    <field name="id_sala" class="java.lang.Integer"/>
    <field name="estado" class="java.lang.String"/>
    <field name="capacidad_total" class="java.lang.Integer"/>
    <field name="id_ticket" class="java.lang.Integer"/>
    <field name="fila_asiento" class="java.lang.String"/>
    <field name="numero_asiento" class="java.lang.Integer"/>
    <field name="cajero" class="java.lang.String"/>
    <field name="monto" class="java.math.BigDecimal"/>
    <field name="fecha_hora_compra" class="java.sql.Timestamp"/>
    <field name="total_boletos" class="java.lang.Long"/>
    <field name="total_ingresos" class="java.math.BigDecimal"/>

    <variable name="BoletosVendidos"
              class="java.lang.Long"
              calculation="First">
        <variableExpression><![CDATA[
            $F{total_boletos}
        ]]></variableExpression>
    </variable>

    <variable name="IngresosTotales"
              class="java.math.BigDecimal"
              calculation="First">
        <variableExpression><![CDATA[
            $F{total_ingresos}
        ]]></variableExpression>
    </variable>

    <title>
        <band height="202">

            <rectangle>
                <reportElement x="0" y="0"
                    width="525" height="75"
                    backcolor="#182235"
                    mode="Opaque"/>
            </rectangle>

            <rectangle>
                <reportElement x="0" y="70"
                    width="525" height="5"
                    backcolor="#B4233C"
                    mode="Opaque"/>
            </rectangle>

            <staticText>
                <reportElement x="20" y="14"
                    width="340" height="24"
                    forecolor="#FFFFFF"/>
                <textElement>
                    <font fontName="SansSerif"
                          size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[CINE | GESTIÓN]]></text>
            </staticText>

            <staticText>
                <reportElement x="20" y="41"
                    width="380" height="19"
                    forecolor="#FFFFFF"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE VENTAS POR FUNCIÓN]]></text>
            </staticText>

            <staticText>
                <reportElement x="407" y="20"
                    width="105" height="20"
                    forecolor="#FFFFFF"/>
                <textElement textAlignment="Right">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ADMINISTRACIÓN]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="94"
                    width="525" height="25"
                    forecolor="#182235"/>
                <textElement>
                    <font size="15" isBold="true"/>
                </textElement>
                <text><![CDATA[Información de la función]]></text>
            </staticText>

            <textField>
                <reportElement x="0" y="126"
                    width="525" height="19"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Película: " + $F{pelicula}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="150"
                    width="525" height="18"/>
                <textFieldExpression><![CDATA[
                    "Función #" + $F{id_funcion}
                    + "   |   Sala " + $F{id_sala}
                    + "   |   Estado: " + $F{estado}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="175"
                    width="155" height="18"/>
                <textFieldExpression><![CDATA[
                    "Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy").format($F{fecha_proyeccion})
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="180" y="175"
                    width="120" height="18"/>
                <textFieldExpression><![CDATA[
                    "Hora: " + new java.text.SimpleDateFormat("HH:mm").format($F{hora_inicio})
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="350" y="175"
                    width="170" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    "Capacidad: " + $F{capacidad_total}
                ]]></textFieldExpression>
            </textField>

        </band>
    </title>

    <columnHeader>
        <band height="49">

            <staticText>
                <reportElement x="0" y="0"
                    width="525" height="22"/>
                <textElement>
                    <font size="13" isBold="true"/>
                </textElement>
                <text><![CDATA[Detalle de boletos vendidos]]></text>
            </staticText>

            <rectangle>
                <reportElement x="0" y="25"
                    width="525" height="24"
                    mode="Opaque"
                    backcolor="#182235"/>
            </rectangle>

            <staticText>
                <reportElement x="8" y="29"
                    width="67" height="16"
                    forecolor="#FFFFFF"/>
                <text><![CDATA[TICKET]]></text>
            </staticText>

            <staticText>
                <reportElement x="80" y="29"
                    width="65" height="16"
                    forecolor="#FFFFFF"/>
                <text><![CDATA[ASIENTO]]></text>
            </staticText>

            <staticText>
                <reportElement x="155" y="29"
                    width="130" height="16"
                    forecolor="#FFFFFF"/>
                <text><![CDATA[CAJERO]]></text>
            </staticText>

            <staticText>
                <reportElement x="290" y="29"
                    width="155" height="16"
                    forecolor="#FFFFFF"/>
                <text><![CDATA[FECHA COMPRA]]></text>
            </staticText>

            <staticText>
                <reportElement x="451" y="29"
                    width="65" height="16"
                    forecolor="#FFFFFF"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[MONTO]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="26">

            <printWhenExpression><![CDATA[
                $F{id_ticket} != null
            ]]></printWhenExpression>

            <rectangle>
                <reportElement x="0" y="0"
                    width="525" height="25"
                    mode="Opaque"
                    backcolor="#F4F5F7">
                    <printWhenExpression><![CDATA[
                        $V{REPORT_COUNT} % 2 == 0
                    ]]></printWhenExpression>
                </reportElement>
            </rectangle>

            <textField>
                <reportElement x="8" y="5"
                    width="67" height="17"/>
                <textFieldExpression><![CDATA[
                    String.valueOf($F{id_ticket})
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="80" y="5"
                    width="65" height="17"/>
                <textFieldExpression><![CDATA[
                    $F{fila_asiento}
                    + "-" + $F{numero_asiento}
                ]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="155" y="5"
                    width="130" height="17"/>
                <textFieldExpression><![CDATA[
                    $F{cajero}
                ]]></textFieldExpression>
            </textField>

            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="290" y="5"
                    width="155" height="17"/>
                <textFieldExpression><![CDATA[
                    $F{fecha_hora_compra}
                ]]></textFieldExpression>
            </textField>

            <textField pattern="$ #,##0.00">
                <reportElement x="451" y="5"
                    width="65" height="17"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[
                    $F{monto}
                ]]></textFieldExpression>
            </textField>

        </band>
    </detail>

    <pageFooter>
        <band height="29">

            <line>
                <reportElement x="0" y="1"
                    width="525" height="1"
                    forecolor="#DCE1E8"/>
            </line>

            <staticText>
                <reportElement x="0" y="10"
                    width="380" height="15"
                    forecolor="#586579"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Sistema de Gestión de Cine | Administración]]></text>
            </staticText>

            <textField>
                <reportElement x="420" y="10"
                    width="105" height="15"
                    forecolor="#586579"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Página " + $V{PAGE_NUMBER}
                ]]></textFieldExpression>
            </textField>

        </band>
    </pageFooter>

    <summary>
        <band height="94">

            <rectangle>
                <reportElement x="0" y="15"
                    width="525" height="62"
                    mode="Opaque"
                    backcolor="#E8F5EC"/>
            </rectangle>

            <staticText>
                <reportElement x="15" y="24"
                    width="220" height="22"
                    forecolor="#167347"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[RESUMEN DE LA FUNCIÓN]]></text>
            </staticText>

            <textField>
                <reportElement x="15" y="51"
                    width="230" height="19"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    "Boletos vendidos: "
                    + $V{BoletosVendidos}
                ]]></textFieldExpression>
            </textField>

            <textField pattern="$ #,##0.00">
                <reportElement x="305" y="46"
                    width="200" height="25"
                    forecolor="#167347"/>
                <textElement textAlignment="Right">
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[
                    $V{IngresosTotales}
                ]]></textFieldExpression>
            </textField>

        </band>
    </summary>    

</jasperReport>